APP_NAME="UPL PRESENCE"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=https://upl-presence.test
APP_TIMEZONE=Africa/Lubumbashi
APP_LOCALE=fr

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=upl_presence
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
CACHE_STORE=database
QUEUE_CONNECTION=sync
MAIL_MAILER=log          # en production : smtp (réinitialisation de mot de passe)
MAIL_FROM_ADDRESS=presence@upl.example
MAIL_FROM_NAME="UPL PRESENCE"
SESSION_SECURE_COOKIE=true

# ---- Réseau (mode démo = SIMULATION, interdit en production) ----
UPL_NETWORK_MODE=demo
UPL_DEMO_SCENARIO=interieur
UPL_CONNECTOR=freeradius
UPL_WIFI_REQUIRED=true
UPL_ALLOWED_SSID=UPL-WIFI
UPL_NETWORK_SESSION_TTL=15
UPL_REQUIRE_SAME_IP=true
UPL_WEBHOOK_SECRET=            # openssl rand -hex 32 — à partager avec le relais RADIUS uniquement
UPL_LOCALISATION_POLICY=strict # strict | ap_gps (assurance faible)
UPL_GPS_MAX_ACCURACY=40
UPL_GPS_OPTIONAL_IF_FINGERPRINT=true

# ---- Connecteur REST générique (secrets : jamais côté navigateur) ----
UPL_CTRL_BASE_URL=
UPL_CTRL_TOKEN=
UPL_CTRL_AUTH_HEADER=Authorization
UPL_CTRL_AUTH_SCHEME=Bearer
UPL_CTRL_VERIFY_SSL=true
UPL_CTRL_EP_CLIENT_RSSI=
UPL_CTRL_EP_TXPOWER=
UPL_CTRL_EP_APSTATUS=
